{
  "name": "youtube-ai",
  "displayName": "YouTube AI",
  "description": "Chat with YouTube videos. Summaries, searchable transcripts and Q&A in the sidebar, powered by your own OpenAI, Anthropic, Google or OpenRouter key.",
  "author": "Paolo Nessim",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaoloJN/youtube-ai-extension.git"
  },
  "license": "MIT",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/react": "^4.0.157",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "^1.0.4",
    "ai": "^7.0.153",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
